# Endpoint compatível com a API da OpenAI.
#
# Padrão abaixo: Groq (nuvem, grátis, sem cartão) — recomendado para deploy,
# já que evita depender de hospedar o modelo você mesmo (e da capacidade
# instável do Oracle Free Tier). Crie uma chave grátis em
# https://console.groq.com/keys e cole abaixo.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.6-27b
# qwen/qwen3.6-27b é um modelo de raciocínio: sem isso, ele vaza um bloco
# <think>...</think> inteiro dentro da resposta. "hidden" descarta o
# raciocínio e devolve só a resposta final (e economiza tokens do TPM).
LLM_REASONING_FORMAT=hidden

# Alternativa: Ollama rodando localmente (não precisa de chave nem internet).
# Para usar, comente as 3 linhas acima e descomente as 3 abaixo.
# ollama pull qwen2.5:7b-instruct && ollama serve
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b-instruct

LLM_TEMPERATURE=0.8
# O tier gratuito da Groq limita por tokens/minuto (ex.: 8000 TPM em
# qwen/qwen3.6-27b) e esse limite conta o max_tokens reservado, não só o que
# é de fato gerado — mantenha isso bem abaixo do limite do seu modelo/tier.
LLM_MAX_TOKENS=4000
REQUEST_TIMEOUT_SECONDS=600
# Orçamento total estimado de tokens por request (prompt + stats do Smogon +
# histórico da conversa + mensagem atual + o próprio LLM_MAX_TOKENS acima).
# O histórico é cortado (turnos mais antigos primeiro) até caber aqui — é o
# que impede uma conversa longa de estourar o TPM. Default deixa margem sob
# os 8000 TPM citados acima; ajuste para o seu tier/modelo real.
LLM_CONTEXT_TOKEN_BUDGET=7500

# Firebase Admin SDK (Firestore) — dados competitivos + memória de conversa.
#
# 1. Crie um projeto em https://console.firebase.google.com, ative o Firestore
#    (Build → Firestore Database).
# 2. Configurações do projeto → Contas de serviço → "Gerar nova chave privada"
#    baixa um .json — salve na raiz do repo como firebase-credentials.json
#    (já está no .gitignore, nunca commite esse arquivo).
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
# Produção (Vercel): não há filesystem para o .json — cole o conteúdo inteiro
# do arquivo nesta variável via painel do Vercel (Settings → Environment
# Variables). Quando definida, tem prioridade sobre FIREBASE_CREDENTIALS_PATH.
FIREBASE_CREDENTIALS_JSON=

# Job que sincroniza dados competitivos (usage stats da Smogon, via
# https://www.smogon.com/stats/) no Firestore. Formatos disponíveis em
# https://www.smogon.com/stats/<mês>/chaos/ — ex.: gen9ou, gen9vgc2026regi.
COMPETITIVE_FORMATS=gen9ou,gen9vgc2026regi
# Protege POST /internal/sync-competitive-stats: exigido no header
# "Authorization: Bearer <valor>". No Vercel, defina uma env var chamada
# exatamente CRON_SECRET no projeto — o Vercel Cron injeta esse header sozinho.
CRON_SECRET=


