# Endpoint compatível com a API da OpenAI.
# Padrão: Ollama rodando localmente (ollama serve + ollama pull qwen2.5:7b-instruct)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct

# Para usar um provedor em nuvem OpenAI-compatible (ex.: Groq) hospedando um
# modelo open-source equivalente, basta trocar as três variáveis acima, ex.:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=coloque_sua_chave_aqui
# LLM_MODEL=qwen2.5-72b-instruct

LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=16000
REQUEST_TIMEOUT_SECONDS=600
